# URL e chaves do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Chave de serviço (NUNCA exponha no client) — usada em rotas admin/server actions
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Senha simples para proteger o painel /admin (ver src/middleware.ts)
ADMIN_PASSWORD=escolha-uma-senha-forte

# URL pública do site, usada para montar o link de acompanhamento
NEXT_PUBLIC_SITE_URL=https://seudominio.vercel.app

# Notificações por e-mail ao cliente (Gmail SMTP)
# Gere a senha de app em https://myaccount.google.com/apppasswords
# (a conta precisa ter verificação em 2 etapas ativada)
GMAIL_USER=brunoamaral.art.studio@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-do-gmail

# Nome exibido como remetente nos e-mails (opcional)
ATELIER_NOME=Atelier Bruno Amaral

# E-mail para onde o cliente pode responder (opcional; padrão: GMAIL_USER)
EMAIL_RESPOSTA=brunoamaral.art.studio@gmail.com
